# ============================================================
#  Repo này DEPLOY CÔNG KHAI qua GitHub Pages (astroq.org), nên mọi thứ commit
#  vào đây là thứ người khác phải tải về khi clone. Giữ nó gọn.
# ============================================================

# ---- Ảnh chụp của bộ kiểm thử ----
# scratchpad/*.py LÀ bộ kiểm thử của dự án và PHẢI được commit (CLAUDE.md đã ghi
# một lần mất `gen_wiki_data.py` vì nó chỉ nằm trên máy). Nhưng ảnh chụp thì không:
# 88 file PNG = 35 MB, chỉ dùng để soi mắt trong một lượt làm việc.
scratchpad/*.png
scratchpad/*.log
# Bản đổ log của một lượt chạy, đặt tên `_…txt` theo cách làm ghi ở nhật ký
# 01/08/2026 (`python … | Out-File` chỉ ghi khi pipeline kết thúc, nên script
# phải tự ghi thẳng ra file mới theo dõi được tiến độ). Dùng xong là bỏ.
scratchpad/_*.txt
# ĐẦU RA của một lượt ĐO (`_perf_audit.json` do `perf_audit_all.py` ghi): nó là
# ẢNH CHỤP số liệu của MỘT máy ở MỘT thời điểm, không phải mã nguồn — commit vào
# là người đọc sau tưởng đó là số liệu hiện hành. Số liệu đáng giữ thì ghi vào
# nhật ký `CLAUDE.md` kèm điều kiện đo; sinh lại: `python scratchpad/perf_audit_all.py`.
scratchpad/_*.json

# ---- Ảnh GỐC chưa tối ưu ----
# Dự án đã hạ kho ảnh từ 72 MB xuống 2,79 MB; đừng đưa bản gốc trở lại.
#   · "luna ngang.png" (1,7 MB) — chỉ được NHẮC trong ghi chú ở game-dodge.html,
#     bản dùng thật là img/luna-side.png (8,7 KB) cắt-thu-nén từ nó.
#   · "AstroQ logo.png" và "tramvutru.png" (1,1 MB mỗi cái) — hiện KHÔNG trang nào
#     tham chiếu. Muốn dùng thì tối ưu trước rồi mới commit, như mọi ảnh khác.
# ⚠️ Ba file này vẫn nằm trong thư mục làm việc — nên chuyển ra ngoài repo để khỏi
#    lẫn, chứ `.gitignore` chỉ chặn commit, không dọn đĩa.
img/luna ngang.png
img/AstroQ logo.png
img/tramvutru.png

# ---- Bản gốc của logo thương hiệu ----
# `img/AstroQ logo1.png` (467 KB, 2162×1080, 68% khung là khoảng trong suốt) là
# bản người dùng đặt vào ngày 31/07/2026. Bản dùng thật là `img/astroq-logo.png`
# (392×114, 7 KB) do `scratchpad/make_logo_asset.py` sinh ra — commit bản gốc vào
# là bắt mọi người clone tải thêm 467 KB cho một thứ vẽ ra 32px.
img/AstroQ logo1.png

# ---- Ảnh gốc của asset Trái Đất ----
# `scratchpad/make_earth_assets.py` tải bản gốc NASA vào đây (2,52 MB) rồi hạ cỡ
# thành img/earth/*.avif|webp (230 KB). Bản gốc chỉ cần khi muốn sinh lại asset;
# commit nó vào là đưa lại đúng 2,5 MB mà ta vừa cắt đi.
img/earth/_src/

# ---- Ảnh gốc 4 mốc thời gian của bước ② ----
# Chủ dự án đặt `img/era/<id>.png` (1536×1024, tổng **8,99 MB**) ngày 02/08/2026;
# `scratchpad/make_era_assets.py` hạ thành `img/era/<id>-{700,1120}.{avif,webp}`
# (992 KB cả 16 file, và một lượt chơi chỉ tải ~162 KB vì ảnh nạp lười từng mốc).
# Commit bản gốc là đưa lại đúng 9 MB mà ta vừa cắt đi — repo này deploy công khai
# qua Pages nên mọi thứ commit là thứ người khác phải tải khi clone.
# ⚠️ Chỉ chặn `.png`, KHÔNG chặn cả thư mục: asset `.avif`/`.webp` PHẢI được commit.
img/era/*.png

# ---- Ảnh gốc của nền buồng lái ----
# Chỗ chủ dự án thả ảnh nền gốc vào; `scratchpad/make_bg_assets.py` đọc từ đây rồi
# sinh `background/<slug>-{1280,1920}.{avif,webp}`. Bản gốc là ảnh dạng photo cỡ
# ≥1920px — đúng loại đã cắt từ 6,9 MB xuống 99 KB một lần rồi, đừng commit lại.
# ⚠️ Chỉ chặn thư mục `originals/`, KHÔNG chặn `background/` — 4 biến thể sinh ra
#    PHẢI được commit thì trang mới có nền.
background/originals/

scratchpad/__pycache__/

# ---- Ảnh chụp rơi ra GỐC REPO ----
# `scratchpad/*.png` đã bị chặn, nhưng probe chạy bằng `python scratchpad/x.py` có
# cwd là gốc repo, nên `pg.screenshot(path="abc.png")` ghi thẳng ra đây. Ngày
# 14/08/2026 quét ra 9 file như vậy (2,4 MB) đang chờ được `git add -A` nuốt vào.
# ⚠️ Chỉ chặn ĐÚNG GỐC (`/*.png`) — mọi ảnh dùng thật đều nằm trong img/, 3d/,
#    ava/, background/ nên không cái nào bị chặn nhầm.
/*.png

# Art gốc 5 asset của ARCADE-03 (2,0 MB, chủ dự án đặt vào 21/08/2026).
# Bản DÙNG THẬT là img/racer/*.png (57 KB) — sinh bằng
# `python scratchpad/make_racer_assets.py`. Repo này deploy công khai qua
# Pages nên đừng commit bản gốc; cùng luật đã áp cho `img/luna ngang.png`.
img/asset.png

# Bản gộp một-file để chơi thử ARCADE-03 (818 KB: CSS/JS/ảnh/phông thành
# data URI). Nó là ĐẦU RA của `scratchpad/bundle_racer.py`, không phải mã
# nguồn — repo này deploy công khai qua Pages nên đừng để 818 KB byte chết
# trong đó. Dựng lại: `python scratchpad/bundle_racer.py`.
scratchpad/racer-test-build.html

# Cache ket qua "URL tra 200" cua `check_quiz_bank.py --urls`, MOT FILE MOI NGAY.
# La du lieu tam theo may, khong phai ket qua kiem thu — commit vao thi bo do o
# may khac se doc mot cache cua ngay khac roi BO QUA phan goi mang that.
scratchpad/_urlcache/
# Van ban nguon da chuan hoa do `fetch_srcs.py`/`fetch_ai_srcs.py` tai ve de
# CHON cau trich. Ban sao cua trang web, sinh lai duoc, khong phai nguon su that.
scratchpad/_src/
